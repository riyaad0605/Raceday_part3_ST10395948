@model CreateCategoryViewModel
@{ ViewData["Title"] = "Edit Category"; }

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-raceday text-white">
                <h4 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Category</h4>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form method="post" asp-route-id="@ViewBag.CategoryId">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <input type="text" name="Name" class="form-control" value="@Model.Name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Distance (km)</label>
                        <input type="number" name="DistanceKm" class="form-control" value="@Model.DistanceKm" step="0.1" min="0.1" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-raceday"><i class="bi bi-check-circle me-2"></i>Save</button>
                        <a href="/Categories" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
