@model List<EnrolmentViewModel>
@{ ViewData["Title"] = "My Events"; }

<h2 class="fw-bold mb-4"><i class="bi bi-bookmark-check me-2" style="color: var(--rd-primary);"></i>My Events</h2>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-calendar-heart d-block"></i>
        <h5>No enrolments yet</h5>
        <p>Browse events and sign up for a race!</p>
        <a href="/Home" class="btn btn-raceday">Browse Events</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var en in Model.OrderByDescending(e => e.EnrolmentDate))
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="fw-bold mb-1">@en.EventName</h5>
                                <span class="badge bg-info me-1">@en.CategoryName</span>
                                <span class="badge badge-@(en.Status == "Confirmed" ? "confirmed" : "pending")">@en.Status</span>
                            </div>
                        </div>
                        <div class="mt-3 text-muted small">
                            <i class="bi bi-calendar3 me-1"></i>Enrolled on @en.EnrolmentDate.ToString("dd MMM yyyy")
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <form method="post" asp-controller="Events" asp-action="Withdraw"
                              asp-route-enrolmentId="@en.EnrolmentId" asp-route-eventId="0"
                              onsubmit="return confirm('Withdraw from this event?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-x-circle me-1"></i>Withdraw
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
